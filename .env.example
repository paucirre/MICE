# Copia este fichero a .env para desarrollo local, o pega estas variables en
# EasyPanel (Entorno) para produccion. NO subas el .env real al repositorio.

# ---------------------------------------------------------------------------
# OBLIGATORIAS. Sin las tres el servicio no arranca, a proposito.
# ---------------------------------------------------------------------------

# Tu clave de OpenAI. Si el analisis falla con 401, revisa esta.
OPENAI_API_KEY=sk-...

# Contrasena de acceso a la demo. La v1 estaba abierta a Internet: cualquiera
# con la URL podia lanzar analisis contra tu cuenta.
DEMO_PASSWORD=cambia-esto

# Secreto para firmar los tokens de sesion. Minimo 32 caracteres.
# Generalo con:  python3 -c "import secrets; print(secrets.token_hex(32))"
# Si lo cambias, todas las sesiones abiertas caducan al instante. Eso es util
# si alguna vez tienes que echar a alguien.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# OPCIONALES. Tienen valores por defecto razonables.
# ---------------------------------------------------------------------------

# Dominios desde los que se acepta el frontend, separados por comas.
# Por defecto: https://utopi.es
ALLOWED_ORIGINS=https://utopi.es

# Modelos. Estan en variables de entorno precisamente porque OpenAI retiro la
# Assistants API y la familia gpt-4o sin que el codigo pudiera hacer nada.
# Si el analisis falla con 404, el mensaje de error te dira que cambies esto.
DIRECTOR_MODEL=gpt-5.6-terra
RESEARCH_MODEL=gpt-5.6-luna

# Analisis permitidos por sesion y hora. Cada analisis lanza ~25 busquedas web
# mas dos llamadas al Director, asi que no lo subas sin motivo.
RATE_LIMIT_POR_HORA=10

# Logs en Logtail. Si lo dejas vacio, el logger no envia nada y el servicio
# sigue funcionando igual.
LOGTAIL_SOURCE_TOKEN=
